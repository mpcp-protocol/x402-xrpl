      "steps": [
        {
          "receipt": { "network": "xrpl:testnet", "txHash": "TX-REPLAY-SAME", "paymentId": "VEC-REPLAY-SAME" },
          "txByHash": {
            "TX-REPLAY-SAME": {
              "validated": true,
              "TransactionType": "Payment",
              "Account": "rPAYER-C",
              "Destination": "rDEST-C",
              "Amount": "1000000",
              "memoPaymentId": "VEC-REPLAY-SAME",
              "meta": { "TransactionResult": "tesSUCCESS", "delivered_amount": "1000000" }
            }
          },
          "expect": { "ok": true, "idempotent": false }
        },
        {
          "receipt": { "network": "xrpl:testnet", "txHash": "TX-REPLAY-SAME", "paymentId": "VEC-REPLAY-SAME" },
          "txByHash": {
            "TX-REPLAY-SAME": {
              "validated": true,
              "TransactionType": "Payment",
              "Account": "rPAYER-C",
              "Destination": "rDEST-C",
              "Amount": "1000000",
              "memoPaymentId": "VEC-REPLAY-SAME",
              "meta": { "TransactionResult": "tesSUCCESS", "delivered_amount": "1000000" }
            }
          },
          "expect": { "ok": true, "idempotent": true }
        }
      ]
    },
