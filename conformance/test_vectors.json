    {
      "id": "paid_in_time_verified_within_grace",
      "description": "Validated before expiry, verified 30 s after: accepted (default grace 60 s)",
      "challenge": {
        "network": "xrpl:testnet",
        "amount": "1",
        "asset": { "kind": "XRP" },
        "destination": "rDEST-N",
        "expiresAt": "2030-01-01T00:00:00Z",
        "paymentId": "VEC-GRACE"
      },
      "steps": [
        {
          "receipt": { "network": "xrpl:testnet", "txHash": "TX-GRACE", "paymentId": "VEC-GRACE" },
          "txByHash": {
            "TX-GRACE": {
              "validated": true,
              "TransactionType": "Payment",
              "Account": "rPAYER-N",
              "Destination": "rDEST-N",
              "Amount": "1000000",
              "memoPaymentId": "VEC-GRACE",
              "meta": { "TransactionResult": "tesSUCCESS", "delivered_amount": "1000000" },
              "closeTime": "2029-12-31T23:59:58Z"
            }
          },
          "expect": { "ok": true, "idempotent": false },
          "now": "2030-01-01T00:00:30Z"
        }
      ]
    },
